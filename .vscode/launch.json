{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug eQ",
            "cargo": {
                "args": [
                    "build",
                    "--bin=eQ",
                    "--package=eQ"
                ],
                "filter": {
                    "name": "eQ",
                    "kind": "bin"
                }
            },
            "program": "${workspaceFolder}/target/debug/eQ", 
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Release eQ",
            "cargo": {
                "args": [
                    "build",
                    "--release",
                    "--bin=eQ",
                    "--package=eQ",
                ],
                "filter": {
                    "name": "eQ",
                    "kind": "bin"
                }
            },
            "program": "${workspaceFolder}/target/release/eQ", 
            "cwd": "${workspaceFolder}"
        }
    ]
}