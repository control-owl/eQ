{
    "version": "0.2.0",

    "compounds": [

        // "eQ - All Releases"
        {
            "name": "eQ - All Releases",
            "configurations": [
                "Release - Default",
                "Release - Dev",
                "Release - OSK"
            ]
        },

        // "eQ - All Debugs"
        {
            "name": "eQ - All Debugs",
            "configurations": [
                "Debug - Default",
                "Debug - Dev",
                "Debug - OSK"
            ]
        }
        
    ],

    "configurations": [
        
        // "Release - Default"
        {
            "type": "lldb",
            "request": "launch",
            "name": "Release - Default",
            "cargo": {
                "args": [
                    "build",
                    "--features=default",
                    "--release",
                    "--bin=eQ",
                    "--package=eQ",
                    "--target-dir=target/default",
                ],
                "filter": {
                    "name": "eQ",
                    "kind": "bin"
                }
            },
            "program": "${workspaceFolder}/target/default/release/eQ",
            "cwd": "${workspaceFolder}"
        },

        // "Release - Dev"
        {
            "type": "lldb",
            "request": "launch",
            "name": "Release - Dev",
            "cargo": {
                "args": [
                    "build",
                    "--features=dev",
                    "--release",
                    "--bin=eQ",
                    "--package=eQ",
                    "--target-dir=target/dev",
                ],
                "filter": {
                    "name": "eQ",
                    "kind": "bin"
                }
            },
            "program": "${workspaceFolder}/target/dev/release/eQ",
            "cwd": "${workspaceFolder}"
        },

        // "Release - OSK"
        {
            "type": "lldb",
            "request": "launch",
            "name": "Release - OSK",
            "cargo": {
                "args": [
                    "build",
                    "--features=osk",
                    "--release",
                    "--bin=eQ",
                    "--package=eQ",
                    "--target-dir=target/osk",
                ],
                "filter": {
                    "name": "eQ",
                    "kind": "bin"
                }
            },
            "program": "${workspaceFolder}/target/osk/release/eQ",
            "cwd": "${workspaceFolder}"
        },



        // "Debug - Default"
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug - Default",
            "cargo": {
                "args": [
                    "build",
                    "--features=default",
                    "--bin=eQ",
                    "--package=eQ",
                    "--target-dir=target/default"
                ],
                "filter": {
                    "name": "eQ",
                    "kind": "bin"
                }
            },
            "program": "${workspaceFolder}/target/default/debug/eQ",
            "cwd": "${workspaceFolder}"
        },

        // "Debug - Dev"
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug - Dev",
            "cargo": {
                "args": [
                    "build",
                    "--features=dev",
                    "--bin=eQ",
                    "--package=eQ",
                    "--target-dir=target/dev",
                ],
                "filter": {
                    "name": "eQ",
                    "kind": "bin"
                }
            },
            "program": "${workspaceFolder}/target/dev/debug/eQ",
            "cwd": "${workspaceFolder}"
        },

        // "Debug - OSK"
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug - OSK",
            "cargo": {
                "args": [
                    "build",
                    "--features=osk",
                    "--bin=eQ",
                    "--package=eQ",
                    "--target-dir=target/osk",
                ],
                "filter": {
                    "name": "eQ",
                    "kind": "bin"
                }
            },
            "program": "${workspaceFolder}/target/osk/debug/eQ",
            "cwd": "${workspaceFolder}"
        },

    ]
}