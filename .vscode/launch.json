{
    "version": "0.2.0",

    "compounds": [

        // "eQ - All Releases"
        {
            "name": "eQ - All Releases",
            "configurations": [
                "eQ [Default] Release",
                "eQ [Dev] Release",
                "eQ [osk] Release"
            ]
        },

        // "eQ - All Debugs"
        {
            "name": "eQ - All Debugs",
            "configurations": [
                "eQ [Default] Debug",
                "eQ [Dev] Debug",
                "eQ [osk] Debug"
            ]
        }
        
    ],

    "configurations": [
        
        // "eQ [Default] Release"
        {
            "type": "lldb",
            "request": "launch",
            "name": "eQ [Default] Release",
            "cargo": {
                "args": [
                    "build",
                    "--features=default",
                    "--release",
                    "--bin=eQ",
                    "--package=eQ",
                    "--target-dir=target/default",
                ],
                "filter": {
                    "name": "eQ",
                    "kind": "bin"
                }
            },
            "program": "${workspaceFolder}/target/default/release/eQ",
            "cwd": "${workspaceFolder}"
        },

        // "eQ [Dev] Release"
        {
            "type": "lldb",
            "request": "launch",
            "name": "eQ [Dev] Release",
            "cargo": {
                "args": [
                    "build",
                    "--features=dev",
                    "--release",
                    "--bin=eQ",
                    "--package=eQ",
                    "--target-dir=target/dev",
                ],
                "filter": {
                    "name": "eQ",
                    "kind": "bin"
                }
            },
            "program": "${workspaceFolder}/target/dev/release/eQ",
            "cwd": "${workspaceFolder}"
        },

        // "eQ [osk] Release"
        {
            "type": "lldb",
            "request": "launch",
            "name": "eQ [osk] Release",
            "cargo": {
                "args": [
                    "build",
                    "--features=osk",
                    "--release",
                    "--bin=eQ",
                    "--package=eQ",
                    "--target-dir=target/osk",
                ],
                "filter": {
                    "name": "eQ",
                    "kind": "bin"
                }
            },
            "program": "${workspaceFolder}/target/osk/release/eQ",
            "cwd": "${workspaceFolder}"
        },



        // "eQ [Default] Debug"
        {
            "type": "lldb",
            "request": "launch",
            "name": "eQ [Default] Debug",
            "cargo": {
                "args": [
                    "build",
                    "--features=default",
                    "--bin=eQ",
                    "--package=eQ",
                    "--target-dir=target/default"
                ],
                "filter": {
                    "name": "eQ",
                    "kind": "bin"
                }
            },
            "program": "${workspaceFolder}/target/default/debug/eQ",
            "cwd": "${workspaceFolder}"
        },

        // "eQ [Dev] Debug"
        {
            "type": "lldb",
            "request": "launch",
            "name": "eQ [Dev] Debug",
            "cargo": {
                "args": [
                    "build",
                    "--features=dev",
                    "--bin=eQ",
                    "--package=eQ",
                    "--target-dir=target/dev",
                ],
                "filter": {
                    "name": "eQ",
                    "kind": "bin"
                }
            },
            "program": "${workspaceFolder}/target/dev/debug/eQ",
            "cwd": "${workspaceFolder}"
        },

        // "eQ [osk] Debug"
        {
            "type": "lldb",
            "request": "launch",
            "name": "eQ [osk] Debug",
            "cargo": {
                "args": [
                    "build",
                    "--features=osk",
                    "--bin=eQ",
                    "--package=eQ",
                    "--target-dir=target/osk",
                ],
                "filter": {
                    "name": "eQ",
                    "kind": "bin"
                }
            },
            "program": "${workspaceFolder}/target/osk/debug/eQ",
            "cwd": "${workspaceFolder}"
        },

    ]
}