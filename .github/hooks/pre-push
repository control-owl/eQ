#!/usr/bin/env bash
# authors = ["Control Owl <eq[at]r-o0-t[dot]wtf>"]
# license = "CC-BY-NC-ND-4.0  [2023-2026]  Control Owl"

# -.-. --- .--. -.-- .-. .. --. .... - / -.-. --- -. - .-. --- .-.. / --- .-- .-..

set -o errexit
set -o nounset
set -o pipefail

RED=$'\e[31m'
GREEN=$'\e[32m'
BOLD=$'\e[1m'
RESET=$'\e[0m'

SEP='-.-. --- .--. -.-- .-. .. --. .... - / -.-. --- -. - .-. --- .-.. / --- .-- .-..'

# -.-. --- .--. -.-- .-. .. --. .... - / -.-. --- -. - .-. --- .-.. / --- .-- .-..

color_ok() { printf '%b%s%b' "$BOLD$GREEN" "OK" "$RESET"; }
color_err() { printf '%b%s%b' "$BOLD$RED" "ERROR" "$RESET"; }

center_header() {
  local header="$1"
  local sep="$SEP"
  local sep_len=${#sep}
  local hdr_len=${#header}
  if [ "$hdr_len" -ge "$sep_len" ]; then
    printf '%s\n' "$header"
    return
  fi
  local left_pad=$(( (sep_len - hdr_len) / 2 ))
  local right_pad=$(( sep_len - hdr_len - left_pad ))
  printf '%*s%s%*s\n' "$left_pad" '' "$header" "$right_pad" ''
}

# -.-. --- .--. -.-- .-. .. --. .... - / -.-. --- -. - .-. --- .-.. / --- .-- .-..

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo ".")"
cd "$REPO_ROOT" || { printf '%b\n' "$BOLD$RED""ERROR: Cannot cd to repo root: $REPO_ROOT""$RESET" >&2; exit 2; }

SCRIPT="pre-push-checks.sh"

if [ ! -e "$SCRIPT" ]; then
  printf '%b\n' "$BOLD$RED""ERROR: $SCRIPT not found.""$RESET" >&2
  exit 2
fi

if [ ! -x "$SCRIPT" ]; then
  if ! chmod +x "$SCRIPT" >/dev/null 2>&1; then
    printf '%b\n' "$BOLD$RED""ERROR: $SCRIPT is not executable and chmod failed.""$RESET" >&2
    exit 2
  fi
fi

# -.-. --- .--. -.-- .-. .. --. .... - / -.-. --- -. - .-. --- .-.. / --- .-- .-..

printf '\n%b%s%b\n\n' "$BOLD$GREEN" "Starting pre-push..." "$RESET"
printf '%s\n\n' "$SEP"

center_header "pre-push hook"
printf '\n'

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue

  if printf '%s' "$remote_sha" | grep -qE '^0+$'; then
    mapfile -t commits < <(git rev-list "$local_sha" 2>/dev/null || true)
  else
    mapfile -t commits < <(git rev-list "${remote_sha}..${local_sha}" 2>/dev/null || true)
  fi

  if [ "${#commits[@]}" -eq 0 ]; then
    continue
  fi

  center_header "Running checks"
  printf '\n'

  if ! "$SCRIPT" "$REPO_ROOT" "${commits[@]}"; then
    printf '%b\n' "$BOLD$RED""Push aborted: pre-push checks failed.""$RESET" >&2
    exit 1
  fi

  printf '\n%s\n\n' "$SEP"
done

# -.-. --- .--. -.-- .-. .. --. .... - / -.-. --- -. - .-. --- .-.. / --- .-- .-..

printf '%b%s%b\n\n' "$BOLD$GREEN" "ALL CHECK DONE" "$RESET"
printf '%b%s%b\n\n' "$BOLD$GREEN" "Pushing to remote..." "$RESET"
printf '%s\n' "$SEP"

exit 0
